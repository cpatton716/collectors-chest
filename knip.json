{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/api/**/route.ts",
    "sentry.*.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/types/**/*.ts",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    "ts-jest",
    "dotenv",
    "postcss-load-config",
    "@netlify/plugin-nextjs"
  ],
  "ignoreBinaries": ["tsx"],
  "next": {
    "entry": [
      "next.config.{js,ts,mjs}",
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/api/**/route.ts"
    ]
  }
}
